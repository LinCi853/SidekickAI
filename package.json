{
  "name": "sidekickai-opensource",
  "version": "0.1.0-alpha.2",
  "description": "工百窗（SidekickAI）—— 全平台 AI 聚合 + 反检测多 Profile 浏览器（Electron）",
  "main": "out/main/index.cjs",
  "author": "SidekickAI",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "electron-rebuild -f -w better-sqlite3 -w uiohook-napi",
    "dev": "node scripts/dev.mjs",
    "gen:icon": "electron scripts/gen-installer-assets.cjs",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "build:win-x64": "electron-vite build && electron-builder --win --x64",
    "build:win-arm64": "electron-vite build && electron-builder --win --arm64",
    "build:win": "npm run build:win-x64 && npm run build:win-arm64",
    "dist": "electron-vite build && electron-builder",
    "build:portable": "electron-vite build && electron-builder --config electron-builder.portable.yml --win",
    "build:portable-zip": "electron-vite build && electron-builder --config electron-builder.portable.yml --win && node scripts/pack-portable.cjs",
    "build:win-all": "npm run build:win && npm run build:portable-zip",
    "build:tauri-installer": "node scripts/build-tauri-installer.cjs",
    "test": "vitest run",
    "test:desktop": "electron-vite build && node scripts/verify-desktop.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "npm run clean:build",
    "clean:build": "node -e \"const fs=require('fs');['out'].forEach(d=>{if(fs.existsSync(d)){fs.rmSync(d,{recursive:true,force:true});console.log('[clean] Removed',d)}})\""
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "better-sqlite3": "^13.0.3",
    "bindings": "^1.5.0",
    "file-uri-to-path": "1.0.0",
    "opencc-js": "^1.4.0",
    "prebuild-install": "^7.1.1",
    "undici": "^6.0.0"
  },
  "optionalDependencies": {
    "uiohook-napi": "^1.5.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@excalidraw/excalidraw": "^0.18.1",
    "@tiptap/extension-code-block-lowlight": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-task-item": "^3.31.3",
    "@tiptap/extension-task-list": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@types/adm-zip": "^0.5.7",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^43.6.0",
    "electron-builder": "^26.16.1",
    "electron-vite": "^2.3.0",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.11",
    "lucide-react": "^0.400.0",
    "mermaid": "^11.4.1",
    "playwright": "1.59.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "typescript": "^5.4.0",
    "vite": "^5.3.0",
    "vitest": "^2.1.9",
    "zustand": "^4.5.0"
  }
}
