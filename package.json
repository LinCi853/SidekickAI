{
  "name": "sidekickai-opensource",
  "version": "0.1.6",
  "description": "免费、丰富、无缝融入电脑使用的 AI 入门工具",
  "main": "out/main/index.cjs",
  "author": "SidekickAI",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "electron-rebuild -f -w better-sqlite3 -w uiohook-napi",
    "dev": "node scripts/dev.mjs",
    "gen:icon": "electron scripts/gen-application-icon.cjs",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "build:win-x64": "electron-vite build && electron-builder --win --x64",
    "build:win-arm64": "electron-vite build && electron-builder --win --arm64",
    "build:win": "npm run build:win-x64 && npm run build:win-arm64",
    "dist": "electron-vite build && electron-builder",
    "build:portable": "node scripts/build-distribution.cjs --mode portable",
    "build:portable-zip": "node scripts/build-distribution.cjs --mode portable",
    "build:win-all": "node scripts/build-distribution.cjs --mode all",
    "test": "vitest run",
    "test:desktop": "electron-vite build && node scripts/verify-desktop.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "npm run clean:build",
    "clean:build": "node -e \"const fs=require('fs');['out'].forEach(d=>{if(fs.existsSync(d)){fs.rmSync(d,{recursive:true,force:true});console.log('[clean] Removed',d)}})\"",
    "product:check": "node packages/product-contract/sync.cjs",
    "product:sync": "node packages/product-contract/sync.cjs --apply",
    "shared:check": "node scripts/shared-source.cjs",
    "prebuild": "npm run product:check && npm run shared:check && npm run architecture:check",
    "workspace:menu": "node scripts/workspace-menu.cjs",
    "test:workspace-menu": "node --test scripts/workspace-menu.test.cjs",
    "test:distribution": "node --test scripts/build-distribution.test.cjs scripts/application-payload.test.cjs scripts/windows-packaging.test.cjs scripts/distribution-toolkit.test.cjs scripts/assemble-application.test.cjs",
    "build:candidate": "node scripts/build-distribution.cjs",
    "build:release": "node scripts/build-distribution.cjs",
    "preflight:release": "node scripts/build-distribution.cjs --preflight",
    "build:candidate:portable": "node scripts/build-distribution.cjs --mode portable",
    "build:candidate:all": "node scripts/build-distribution.cjs --mode all",
    "build:release:portable": "node scripts/build-distribution.cjs --mode portable",
    "architecture:check": "node scripts/architecture-check.mjs",
    "test:architecture": "node --test scripts/architecture-check.test.mjs",
    "build:payload": "node scripts/build-distribution.cjs --mode payload",
    "build:installer": "node scripts/build-distribution.cjs --mode installer",
    "build:complete": "node scripts/build-distribution.cjs --mode complete",
    "preflight:complete": "node scripts/build-distribution.cjs --mode complete --preflight",
    "build:candidate:payload": "node scripts/build-distribution.cjs --mode payload",
    "versions:check": "node scripts/sync-versions.cjs --check",
    "test:tooling": "node --test scripts/workspace-menu.test.cjs scripts/shared-source.test.cjs scripts/sync-versions.test.cjs scripts/product-version.test.cjs scripts/local-build-config.test.cjs scripts/incremental-build.test.cjs scripts/build-distribution.test.cjs scripts/application-payload.test.cjs scripts/windows-packaging.test.cjs scripts/distribution-toolkit.test.cjs scripts/assemble-application.test.cjs",
    "verify": "npm run product:check && npm run shared:check && npm run versions:check && npm run architecture:check && npm run typecheck && npm run test:tooling && npm test -- --maxWorkers=4 --minWorkers=1"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "better-sqlite3": "^13.0.3",
    "bindings": "^1.5.0",
    "file-uri-to-path": "1.0.0",
    "opencc-js": "^1.4.2",
    "prebuild-install": "^7.1.1",
    "undici": "^6.0.0",
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  },
  "optionalDependencies": {
    "uiohook-napi": "^1.5.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@excalidraw/excalidraw": "^0.18.1",
    "@types/adm-zip": "^0.5.7",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^43.7.9",
    "electron-builder": "^26.17.0",
    "electron-vite": "^2.3.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.0",
    "lucide-react": "^0.400.0",
    "mermaid": "^11.4.1",
    "playwright": "1.64.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "typescript": "^5.4.0",
    "vite": "^5.3.0",
    "vitest": "^2.1.9",
    "zustand": "^4.5.0"
  },
  "editionSessionProtocol": 2
}
