{
  "name": "sidekickai-opensource",
  "version": "0.1.7",
  "description": "免费、丰富、无缝融入电脑使用的 AI 入门工具",
  "main": "out/main/index.cjs",
  "author": "SidekickAI",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "electron-rebuild -f -w better-sqlite3 -w uiohook-napi",
    "dev": "node scripts/dev.mjs",
    "gen:icon": "electron scripts/gen-application-icon.cjs",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "build:win-x64": "electron-vite build && electron-builder --win --x64",
    "build:win-arm64": "electron-vite build && electron-builder --win --arm64",
    "build:win": "npm run build:win-x64 && npm run build:win-arm64",
    "dist": "electron-vite build && electron-builder",
    "build:portable": "node scripts/build-distribution.cjs --mode portable",
    "build:portable-zip": "node scripts/build-distribution.cjs --mode portable",
    "build:win-all": "node scripts/build-distribution.cjs --mode all",
    "test": "vitest run",
    "test:desktop": "electron-vite build && node scripts/verify-desktop.cjs",
    "test:memory-flow": "node scripts/verify-resident-memory-ab.mjs 30 --enabled-only --functional",
    "test:memory-reclaim": "node scripts/verify-resident-memory-ab.mjs 45 --enabled-only --functional --reclaim-flow",
    "test:memory-browsers": "node scripts/verify-resident-memory-ab.mjs 45 --enabled-only --functional --browsers --active-input",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint:check": "biome lint .",
    "clean": "npm run clean:build && npm run clean:temp",
    "clean:budget": "node scripts/clean-budget.cjs && node scripts/clean-temp.cjs",
    "clean:temp": "node scripts/clean-temp.cjs",
    "clean:build": "node -e \"const fs=require('fs');['out'].forEach(d=>{if(fs.existsSync(d)){fs.rmSync(d,{recursive:true,force:true});console.log('[clean] Removed',d)}})\"",
    "product:check": "node packages/product-contract/sync.cjs",
    "product:sync": "node packages/product-contract/sync.cjs --apply",
    "shared:check": "node scripts/shared-source.cjs",
    "prebuild": "npm run product:check && npm run shared:check && npm run format:check && npm run lint:check && npm run architecture:check",
    "workspace:menu": "node scripts/workspace-menu.cjs",
    "test:workspace-menu": "node --test scripts/workspace-menu.test.cjs",
    "test:distribution": "node --test scripts/build-distribution.test.cjs scripts/application-payload.test.cjs scripts/windows-packaging.test.cjs scripts/distribution-toolkit.test.cjs scripts/assemble-application.test.cjs",
    "build:candidate": "node scripts/build-distribution.cjs",
    "build:release": "node scripts/build-distribution.cjs",
    "preflight:release": "node scripts/build-distribution.cjs --preflight",
    "build:candidate:portable": "node scripts/build-distribution.cjs --mode portable",
    "build:candidate:all": "node scripts/build-distribution.cjs --mode all",
    "build:release:portable": "node scripts/build-distribution.cjs --mode portable",
    "architecture:check": "node scripts/architecture-check.mjs",
    "test:architecture": "node --test scripts/architecture-check.test.mjs",
    "deadcode:check": "node scripts/deadcode-check.mjs",
    "test:deadcode": "node --test scripts/deadcode-check.test.mjs",
    "build:payload": "node scripts/build-distribution.cjs --mode payload",
    "build:installer": "node scripts/build-distribution.cjs --mode installer",
    "build:complete": "node scripts/build-distribution.cjs --mode complete",
    "preflight:complete": "node scripts/build-distribution.cjs --mode complete --preflight",
    "build:candidate:payload": "node scripts/build-distribution.cjs --mode payload",
    "versions:check": "node scripts/sync-versions.cjs --check",
    "test:tooling": "node --test scripts/workspace-menu.test.cjs scripts/shared-source.test.cjs scripts/sync-versions.test.cjs scripts/product-version.test.cjs scripts/local-build-config.test.cjs scripts/incremental-build.test.cjs scripts/build-distribution.test.cjs scripts/application-payload.test.cjs scripts/windows-packaging.test.cjs scripts/distribution-toolkit.test.cjs scripts/assemble-application.test.cjs scripts/clean-temp.test.cjs",
    "test:backup": "vitest run --root packages/backup-core",
    "test:host-backup": "node --test scripts/host-backup.test.cjs",
    "build:host-backup": "npm run product:check && npm run shared:check && node scripts/build-host-backup.cjs",
    "verify": "npm run product:check && npm run shared:check && npm run versions:check && npm run format:check && npm run lint:check && npm run architecture:check && npm run deadcode:check && npm run typecheck && npm run test:tooling && npm run test:deadcode && npm test && npm run test:backup && npm run test:host-backup"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "better-sqlite3": "^13.0.3",
    "opencc-js": "^1.4.2",
    "undici": "^8.12.3",
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  },
  "optionalDependencies": {
    "uiohook-napi": "^1.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@electron/asar": "^3.4.1",
    "@electron/rebuild": "^4.2.1",
    "@excalidraw/excalidraw": "^0.18.1",
    "@types/adm-zip": "^0.6.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "buffer-crc32": "^1.0.0",
    "electron": "^43.8.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^5.0.0",
    "esbuild": "0.28.2",
    "highlight.js": "^11.12.0",
    "js-yaml": "^5.5.0",
    "knip": "^6.43.0",
    "lucide-react": "^1.62.0",
    "node-gyp-build": "^4.8.4",
    "playwright": "1.64.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "typescript": "^5.4.0",
    "vite": "^7.3.7",
    "vitest": "^5.0.5",
    "zustand": "^5.0.16"
  },
  "editionSessionProtocol": 2
}
