scripts/standalone-preloads.*
scripts/excalidraw-*
scripts/compilation-inputs.ts
scripts/windows-executable-signing.cjs

# 共享台账钉住的公开测试/验证/构建脚本必须入库
# （maintenance/shared-source.json 把它们列为共享源，CI 的 shared:check 在全新检出里缺任何一个都会判为漂移）
!scripts/backup-durable-runtime.test.cjs
!scripts/backup-recovery-runtime.test.cjs
!scripts/backup-snapshot-runtime.test.cjs
!scripts/build-distribution.test.cjs
!scripts/incremental-build.test.cjs
!scripts/local-build-config.test.cjs
!scripts/product-version.test.cjs
!scripts/shared-source.test.cjs
!scripts/startup-helper-native.test.cjs
!scripts/workspace-menu.test.cjs
!scripts/fixtures/backup-recovery-runtime.cjs
!scripts/fixtures/backup-snapshot-runtime.cjs
!scripts/verify-edition-coexistence.cjs
!scripts/verify-packaged-ui.cjs
!scripts/verify-startup-helper.cjs
!scripts/workspace-menu.cjs
!scripts/prepare-startup-helper.cjs
!scripts/renderer-security.ts
!scripts/standalone-preloads.ts
!scripts/standalone-preloads.test.ts
!scripts/compilation-inputs.ts
!scripts/windows-executable-signing.cjs
# electron.vite.config.ts 直接 import 的构建插件，缺了它 CI 的 npm run build 会直接起不来
!scripts/excalidraw-clipboard-feedback.ts
!scripts/excalidraw-feedback.test.ts
