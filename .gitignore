# ============================================================
# Dependencies
# ============================================================
node_modules/
# 本项目统一使用 npm（package-lock.json 为唯一事实源）
# 忽略其他包管理器误生成的锁文件
pnpm-lock.yaml
bun.lock
bun.lockb

# ============================================================
# Build Outputs
# ============================================================
# electron-vite 中间产物（主/preload/渲染层编译输出）
out/
# electron-builder 标准安装包输出（NSIS exe）
dist/
# electron-builder 便携版输出
dist-portable/
# 发布产物归档目录（安装包 + 便携版，由 launch.bat [2] 生成）
release/
target-check/
build/cargo-targets/
# 构建候选、组件缓存与打包锁（launch.bat 与构建脚本生成，非源码）
build/distribution-runs/
build/component-cache/
build/shared-components/
build/packaging.lock
build/opensource-installer-*/
build/incremental-concept-runs/
build/incremental-native-acceptance/
build/setup-metadata.json
build/native-test-artifacts/
build/native-test-evidence.json
/build/*
!/build/License.txt

# ============================================================
# Electron Cache
# ============================================================
.electron-cache/

# ============================================================
# Runtime Data (app data / user profiles / cache)
# ============================================================
.app-data/
.app-data-installed/
.app-data.instance/
deliverables/
local/
.dsh-shots/

# ============================================================
# Logs
# ============================================================
*.log
*.log.*
chk-*.txt
# 临时调试输出（asar 列表、运行时 stdout/stderr 捕获）
asar-list.txt
sidekick-stdout.txt
sidekick-stderr.txt

# ============================================================
# Editor / OS
# ============================================================
.vscode/
.idea/
.DS_Store
Thumbs.db

# ============================================================
# Dev / Design Documents (开发需求、设计文档、原型)
# ============================================================
# 仅保留源码 + README + LICENSE；其余文档、测试/设计稿一律不入库
.trae/
.uploads/
.claude/
.mimocode/
.workbuddy/
_fixes/
ai-window-uiux/
ai-window-uiux-v2/
# 本地文档目录；构建输入统一放在 contracts/ 并随源码跟踪
/docs/
/website/
tests/
showcase.html
# 根目录散落 .md 不入库（仅以下开源基建文件例外）
/*.md
!/README.md
!/CHANGELOG.md
!/LICENSE
!/CONTRIBUTING.md
!/SECURITY.md
!/AGENTS.md

# Internal specifications and maintenance instructions stay local.
/AGENTS.md

# ============================================================
# Misc
# ============================================================
*.asar
# 临时构建验证脚本（一次性调试，非产品代码）
build/test-*.mjs
# 一次性 PoC / 调试实验脚本（验证完毕，未入库）
scripts/poc/
# 测试/测量/本地工具脚本不入库（源码仓只保留发布构建链）
scripts/*.test.*
!scripts/architecture-check.test.mjs
!scripts/host-backup.test.cjs
scripts/verify-*
!scripts/verify-packaged-native.cjs
scripts/measure-*
scripts/memory-*
scripts/prepare-resident-*
scripts/resident-*
