{
  "name": "sidekickai-installer-tauri",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "SidekickAI 安装向导（Tauri 2 + React，4K 矢量渲染）",
  "scripts": {
    "predev": "node ../scripts/gen-install-manifest.cjs",
    "prebuild": "node ../scripts/gen-install-manifest.cjs",
    "prettauri": "node ../scripts/gen-install-manifest.cjs",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.4.0",
    "vite": "^5.3.0"
  }
}
