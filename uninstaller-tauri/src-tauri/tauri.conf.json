{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SidekickAI",
  "version": "1.1.0",
  "identifier": "com.sidekickai.opensource.uninstaller",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "node ../scripts/tauri-web-build.cjs ../uninstaller-tauri",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "工百窗卸载向导",
        "width": 960,
        "height": 620,
        "minWidth": 860,
        "minHeight": 560,
        "resizable": false,
        "maximizable": false,
        "fullscreen": false,
        "decorations": false,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
