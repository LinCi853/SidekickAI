# https://editorconfig.org —— 统一编辑器基础风格（对齐现有代码：2 空格 / LF / UTF-8）
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml,json}]
indent_size = 2

[*.rs]
indent_size = 4

[*.{bat,cmd}]
end_of_line = crlf
